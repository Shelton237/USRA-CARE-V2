# Copier ce fichier en .env et remplir les valeurs

# Base de données MySQL
DATABASE_URL="mysql://root:motdepasse@localhost:3306/usra_backoffice"

# NextAuth (générer un secret fort en production)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="changez-ce-secret-en-production"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="USRA-CARE"

# Mail (SMTP) — pour l'envoi des factures par email
MAIL_HOST="mail.usra-care.com"
MAIL_PORT="465"
MAIL_ENCRYPTION="ssl"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="contact@usra-care.com"
MAIL_FROM_NAME="USRA CARE"
